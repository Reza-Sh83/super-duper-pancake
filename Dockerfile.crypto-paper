FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY crypto_paper/requirements.lock /app/requirements.lock
RUN python -m pip install --no-cache-dir --no-deps --require-hashes -r /app/requirements.lock \
    && python -c "import sys, websockets; assert sys.version_info[:2] == (3,12) and websockets.__version__ == '15.0.1'"
COPY crypto_paper/ /app/crypto_paper/
COPY fixtures/crypto/ /app/fixtures/crypto/
COPY docker/crypto_probe.py /app/crypto_probe.py
RUN mkdir /evidence && chown 65532:65532 /evidence
USER 65532:65532
STOPSIGNAL SIGINT
ENTRYPOINT ["python", "-m", "crypto_paper"]
